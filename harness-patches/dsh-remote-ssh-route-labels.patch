+ * Empty when the path is not a route placeholder, so every other caller is
+ * unaffected. Same-named remote directories on different hosts would
+ * otherwise share one indistinguishable title.
+ */
+export function routePlaceholderSuffix(path: string): string {
+  const route = /(?:^|[\\/])dsh-ssh-routes[\\/]([^\\/]+)[\\/]/.exec(path)
