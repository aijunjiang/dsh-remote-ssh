+  /**
+   * Stop one background job owned by a Session from the browser UI.
+   *
+   * The jobs registry fences by owner session id, so the caller only ever
+   * names (session, jobId) pairs the session it manages may own. The stop
+   * request is delivered to the job's hooks (for remote jobs: a real
+   * process-group kill on the target).
+   * @param request - owning Session id and the job id to stop.
+   * @returns `requested` for live work, otherwise `already-finished`.
+   * @throws when the session has no job registry or the job is foreign.
+   */
+  @Remote('jobStop')
+  jobStop(request: { sessionId: SessionId; jobId: string }): 'requested' | 'already-finished' {
+    const jobs = this.ctx.get('jobs') as { kill(id: string, caller?: unknown, reason?: string): string } | undefined
+    if (jobs === undefined) {
+      throw new Error('session-controller: no background-job registry is mounted')
+    }
+    return jobs.kill(request.jobId, { id: request.sessionId }, 'stopped from the session header') as 'requested' | 'already-finished'
+  }
+
