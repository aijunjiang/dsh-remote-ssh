                    "./package.json":  "./package.json"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "*",
                             "@deepseek-ai/schemastery":  "*"
                         },
    "dependencies":  {
                         "ssh2":  "1.17.0"
                     },
