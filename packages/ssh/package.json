{
    "name":  "dsh-ssh",
    "version":  "0.2.0",
    "private":  true,
    "description":  "Shared ownership of one SSH connection and its remote helper daemon, so filesystem and subprocess providers inhabit one remote world.",
    "type":  "module",
    "main":  "src/index.ts",
